cabal-version: 3.0
name: masroufy
version: 0.1.0.0
build-type: Simple

executable masroufy
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2 -Wall
  build-depends:
    base >=4.18 && <5, aeson, bytestring, containers, crypton,
    directory, http-types, memory, scotty >=0.22 && <0.31,
    sqlite-simple, text, time, wai, warp
